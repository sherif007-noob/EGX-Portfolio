# SERVER-SIDE ONLY Firebase Admin credentials for the one-time Firestore -> Supabase migration and authenticated Supabase API.
# Never expose these values to the browser or commit real credentials.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Firebase Auth UID whose portfolio document is the canonical user snapshot.
FIREBASE_ADMIN_OWNER_UID=

# SERVER-SIDE ONLY Supabase secret key. Never expose this value to browser code or commit it.
SUPABASE_URL=https://jhubsrbfiqjxdgngnwaq.supabase.co
SUPABASE_SECRET_KEY=

# Browser-safe Supabase configuration. The publishable key is intentionally NOT used
# for portfolio writes; the browser calls same-origin API routes authenticated by Firebase.
VITE_SUPABASE_URL=https://jhubsrbfiqjxdgngnwaq.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set to true only while intentionally running the isolated one-time migration page.
ENABLE_SUPABASE_MIGRATION_UI=false
