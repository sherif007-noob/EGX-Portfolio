{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "egx-portfolio",
  "main": "worker.ts",
  "compatibility_date": "2026-09-23",
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
