# SERVER-SIDE ONLY Firebase Admin credentials for the one-time Firestore -> Supabase migration.
# Never expose these values to the browser or commit real credentials.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Firebase Auth UID whose portfolio document should be preferred over main_portfolio.
# Optional if the canonical source is portfolios/main_portfolio.
FIREBASE_ADMIN_OWNER_UID=

# SERVER-SIDE ONLY Supabase secret key. Never expose this value to browser code or commit it.
SUPABASE_URL=https://jhubsrbfiqjxdgngnwaq.supabase.co
SUPABASE_SECRET_KEY=

# Set to true only while intentionally running the isolated migration page.
ENABLE_SUPABASE_MIGRATION_UI=false
